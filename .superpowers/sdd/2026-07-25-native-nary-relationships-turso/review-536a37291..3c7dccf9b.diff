+        name: impl Into<String>,
+        source: impl Into<String>,
+        start: Vec<String>,
+        end: Vec<String>,
+        properties: Vec<SemanticProperty>,
+    ) -> Self {
+        Self {
+            name: name.into(),
+            source: source.into(),
+            roles: vec![
