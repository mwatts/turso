+    pub fn execute_create_relation(
+        &self,
+        relation: &str,
+        roles: &[(&str, i64)],
+        properties: &[(&str, i64)],
+    ) -> Result<Value, Error> {
+        self.refresh_catalog_if_stale()?;
+        let catalog = self.catalog.read().clone();
+        let relationship_type = catalog
+            .relationship_type(self.graph, relation)
+            .unwrap_or_else(|| panic!("unknown relationship type {relation:?}"));
+        let source = catalog
+            .relationship_source_for_type(self.graph, relationship_type)
+            .unwrap_or_else(|| panic!("relationship type {relation:?} has no source"));
+        let layout = catalog
+            .relationship_source_roles(source)
+            .unwrap_or_else(|| panic!("relationship type {relation:?} has no role layout"));
+
+        let mut values = HashMap::new();
+        let mut role_bindings = Vec::with_capacity(roles.len());
+        for (index, (name, player)) in roles.iter().enumerate() {
+            let role = layout
+                .roles
+                .iter()
+                .find(|candidate| candidate.name.eq_ignore_ascii_case(name))
+                .unwrap_or_else(|| panic!("relationship type {relation:?} has no role {name:?}"));
+            let binding_id = ir::BindingId::new((index as u32) + 1).expect("nonzero binding id");
+            values.insert(binding_id, Value::from_i64(*player));
+            role_bindings.push(ir::RoleBinding {
+                role: role.role,
+                value: binding_id,
+            });
+        }
+
+        let mut property_values = Vec::with_capacity(properties.len());
+        for (name, value) in properties {
+            let resolved = catalog
+                .property(self.graph, CatalogEntity::Relationship, name)
+                .unwrap_or_else(|| {
+                    panic!("relationship type {relation:?} has no property {name:?}")
+                });
+            property_values.push(ir::PropertyValue {
+                property: resolved.id,
+                semantic_types: vec![relation.to_owned()],
+                value: ir::TypedExpression {
+                    expression: ir::Expression::Literal(ir::Literal::Integer(*value)),
+                    value_type: ir::ValueType::Integer,
