// Source: https://github.com/rustic-ai/uni-db
// Revision: 0812a496c62769b67cf688930750ae384e3de68d
// Path: crates/uni-cypher/src/grammar/cypher.pest
// License: Apache-2.0
// Adaptation: structural-adaptation
// Changes: Reduced to the initial read-query slice and changed to emit only
// Turso-owned source syntax.

WHITESPACE = _{ " " | "\t" | "\n" | "\r" }
COMMENT = _{ "//" ~ (!"\n" ~ ANY)* | "/*" ~ (!"*/" ~ ANY)* ~ "*/" }

MATCH = @{ ^"match" ~ !ident_char }
OPTIONAL = @{ ^"optional" ~ !ident_char }
WHERE = @{ ^"where" ~ !ident_char }
WITH = @{ ^"with" ~ !ident_char }
RETURN = @{ ^"return" ~ !ident_char }
UNWIND = @{ ^"unwind" ~ !ident_char }
CREATE = @{ ^"create" ~ !ident_char }
MERGE = @{ ^"merge" ~ !ident_char }
SET = @{ ^"set" ~ !ident_char }
REMOVE = @{ ^"remove" ~ !ident_char }
DELETE = @{ ^"delete" ~ !ident_char }
DETACH = @{ ^"detach" ~ !ident_char }
ORDER = @{ ^"order" ~ !ident_char }
BY = @{ ^"by" ~ !ident_char }
ASC = @{ (^"ascending" | ^"asc") ~ !ident_char }
DESC = @{ (^"descending" | ^"desc") ~ !ident_char }
SKIP = @{ ^"skip" ~ !ident_char }
LIMIT = @{ ^"limit" ~ !ident_char }
AS = @{ ^"as" ~ !ident_char }
DISTINCT = @{ ^"distinct" ~ !ident_char }
AND = @{ ^"and" ~ !ident_char }
OR = @{ ^"or" ~ !ident_char }
NULL = @{ ^"null" ~ !ident_char }
TRUE = @{ ^"true" ~ !ident_char }
FALSE = @{ ^"false" ~ !ident_char }

ident_char = _{ ASCII_ALPHANUMERIC | "_" }
keyword = _{ MATCH | OPTIONAL | WHERE | WITH | RETURN | UNWIND | CREATE | MERGE | SET | REMOVE | DELETE | DETACH | ORDER | BY | ASC | DESC | SKIP | LIMIT | AS | DISTINCT | AND | OR | NULL | TRUE | FALSE }
identifier = @{ !keyword ~ ((ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* | "`" ~ (!"`" ~ ANY)* ~ "`") }
// Alias positions accept reserved keywords (RETURN 1 AS match).
alias_identifier = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* | "`" ~ (!"`" ~ ANY)* ~ "`" }
parameter = @{ "$" ~ (ASCII_ALPHANUMERIC | "_")+ }
unsigned_integer = @{ ASCII_DIGIT ~ (ASCII_DIGIT | "_")* }
integer = @{ "-"? ~ ASCII_DIGIT ~ (ASCII_DIGIT | "_")* }
real = @{ "-"? ~ ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT+ ~ real_exponent? | "-"? ~ "." ~ ASCII_DIGIT+ ~ real_exponent? | "-"? ~ ASCII_DIGIT+ ~ real_exponent }
real_exponent = @{ ^"e" ~ ("+" | "-")? ~ ASCII_DIGIT+ }
string = @{ ("'" ~ ("''" | "\\'" | !("'" | "\\") ~ ANY | "\\" ~ ANY)* ~ "'") | ("\"" ~ ("\"\"" | "\\\"" | !("\"" | "\\") ~ ANY | "\\" ~ ANY)* ~ "\"") }

query = { SOI ~ clause+ ~ union_branch* ~ EOI }
union_branch = { UNION ~ ALL? ~ clause+ }
UNION = @{ ^"union" ~ !ident_char }
ALL = @{ ^"all" ~ !ident_char }
clause = { match_clause | create_clause | merge_clause | set_clause | remove_clause | delete_clause | unwind_clause | with_clause | return_clause | foreach_clause | call_subquery | call_clause }
call_subquery = { CALL ~ "{" ~ clause+ ~ union_branch* ~ "}" }
call_clause = { CALL ~ qualified_name ~ ("(" ~ expression_list? ~ ")")? ~ (YIELD ~ identifier ~ ("," ~ identifier)*)? }
CALL = @{ ^"call" ~ !ident_char }
YIELD = @{ ^"yield" ~ !ident_char }
qualified_name = { identifier ~ ("." ~ identifier)* }
foreach_clause = { FOREACH ~ "(" ~ identifier ~ in_op ~ expression ~ "|" ~ foreach_body ~ ")" }
FOREACH = @{ ^"foreach" ~ !ident_char }
foreach_body = { (create_clause | merge_clause | set_clause | remove_clause | delete_clause | foreach_clause)+ }
match_clause = { OPTIONAL? ~ MATCH ~ pattern ~ where_clause? }
create_clause = { CREATE ~ pattern }
merge_clause = { MERGE ~ path_pattern ~ merge_action* }
merge_action = { ON ~ (CREATE | MATCH) ~ SET ~ set_item ~ ("," ~ set_item)* }
ON = @{ ^"on" ~ !ident_char }
set_clause = { SET ~ set_item ~ ("," ~ set_item)* }
set_item = { set_property_item | set_merge_item | set_replace_item | set_label_item }
set_property_item = { property_target ~ "=" ~ expression }
set_merge_item = { identifier ~ "+=" ~ expression }
set_replace_item = { identifier ~ "=" ~ expression }
set_label_item = { identifier ~ node_labels }
remove_clause = { REMOVE ~ property_target ~ ("," ~ property_target)* }
property_target = { identifier ~ "." ~ identifier }
delete_clause = { DETACH? ~ DELETE ~ identifier ~ ("," ~ identifier)* }
unwind_clause = { UNWIND ~ expression ~ AS ~ alias_identifier }
with_clause = { WITH ~ DISTINCT? ~ projection_items ~ where_clause? ~ projection_tail }
return_clause = { RETURN ~ DISTINCT? ~ projection_items ~ projection_tail }
where_clause = { WHERE ~ expression }
projection_tail = { order_by_clause? ~ skip_clause? ~ limit_clause? }
order_by_clause = { ORDER ~ BY ~ sort_item ~ ("," ~ sort_item)* }
sort_item = { expression ~ (ASC | DESC)? }
skip_clause = { SKIP ~ expression }
limit_clause = { LIMIT ~ expression }

pattern = { path_pattern ~ ("," ~ path_pattern)* }
path_pattern = { (identifier ~ "=")? ~ node_pattern ~ (relationship_pattern ~ node_pattern)* }
node_pattern = { "(" ~ identifier? ~ node_labels? ~ map_literal? ~ ")" }
node_labels = { (":" ~ identifier)+ }

relationship_pattern = { incoming_relationship | outgoing_relationship | undirected_relationship }
incoming_relationship = { "<-" ~ relationship_body? ~ "-" }
outgoing_relationship = { "-" ~ relationship_body? ~ "->" }
undirected_relationship = { "-" ~ relationship_body? ~ "-" }
relationship_body = { "[" ~ identifier? ~ relationship_types? ~ range_literal? ~ map_literal? ~ "]" }
relationship_types = { ":" ~ identifier ~ ("|" ~ ":"? ~ identifier)* }
range_literal = { "*" ~ unsigned_integer? ~ (".." ~ unsigned_integer?)? }

projection_items = { projection_all | projection_item ~ ("," ~ projection_item)* }
projection_all = { "*" }
projection_item = { expression ~ (AS ~ alias_identifier)? }

expression = { or_expression }
or_expression = { and_expression ~ ((or_op | xor_op) ~ and_expression)* }
or_op = { OR }
xor_op = @{ ^"xor" ~ !ident_char }
and_expression = { not_expression ~ (and_op ~ not_expression)* }
and_op = { AND }
not_expression = { not_op* ~ comparison_expression }
not_op = @{ ^"not" ~ !ident_char }
comparison_expression = { predicate_expression ~ (comparison_op ~ predicate_expression)* }
comparison_op = { "<->" | "<=>" | "<#>" | "<>" | "!=" | "<=" | ">=" | "=" | "<" | ">" }
predicate_expression = { additive_expression ~ predicate_suffix* }
predicate_suffix = { in_suffix | null_suffix | starts_suffix | ends_suffix | contains_suffix | label_suffix }
label_suffix = { node_labels }
in_suffix = { in_op ~ additive_expression }
in_op = @{ ^"in" ~ !ident_char }
null_suffix = { IS ~ not_op? ~ NULL }
IS = @{ ^"is" ~ !ident_char }
starts_suffix = { STARTS ~ WITH ~ additive_expression }
STARTS = @{ ^"starts" ~ !ident_char }
ends_suffix = { ENDS ~ WITH ~ additive_expression }
ENDS = @{ ^"ends" ~ !ident_char }
contains_suffix = { CONTAINS ~ additive_expression }
CONTAINS = @{ ^"contains" ~ !ident_char }
additive_expression = { multiplicative_expression ~ (additive_op ~ multiplicative_expression)* }
additive_op = { "+" | "-" }
multiplicative_expression = { power_expression ~ (multiplicative_op ~ power_expression)* }
multiplicative_op = { "*" | "/" | "%" }
power_expression = { json_expression ~ (power_op ~ json_expression)* }
power_op = { "^" }
json_expression = { postfix_expression ~ (json_op ~ postfix_expression)* }
json_op = { "->>" | "->" | "#>>" | "#>" | "?|" | "?&" | "?" | "@>" | "<@" }
postfix_expression = { primary_expression ~ postfix_suffix* }
postfix_suffix = { property_suffix | index_suffix | cast_suffix | call_suffix }
property_suffix = { "." ~ identifier }
index_suffix = { "[" ~ dotdot ~ expression ~ "]" | "[" ~ expression ~ (dotdot ~ expression?)? ~ "]" }
dotdot = @{ ".." }
cast_suffix = { "::" ~ identifier }
call_suffix = { "(" ~ DISTINCT? ~ expression_list? ~ ")" }
primary_expression = { case_expression | quantifier_expression | reduce_expression | pattern_subquery | function_call | list_comprehension | list_literal | map_literal | literal | parameter | identifier | pattern_predicate | "(" ~ expression ~ ")" }
pattern_subquery = { subquery_kind ~ ("{" ~ MATCH? ~ pattern ~ where_clause? ~ return_clause? ~ "}" | "(" ~ pattern ~ ")") }
subquery_kind = @{ (^"exists" | ^"count") ~ !ident_char }
pattern_predicate = { node_pattern ~ (relationship_pattern ~ node_pattern)+ }
quantifier_expression = { quantifier_kind ~ "(" ~ identifier ~ in_op ~ expression ~ WHERE ~ expression ~ ")" }
reduce_expression = { reduce_kw ~ "(" ~ identifier ~ "=" ~ expression ~ "," ~ identifier ~ in_op ~ expression ~ "|" ~ expression ~ ")" }
reduce_kw = @{ ^"reduce" ~ !ident_char }
quantifier_kind = @{ (^"all" | ^"any" | ^"none" | ^"single") ~ !ident_char }
list_comprehension = { "[" ~ identifier ~ in_op ~ expression ~ (WHERE ~ expression)? ~ ("|" ~ expression)? ~ "]" }
case_expression = { CASE ~ case_subject? ~ when_clause+ ~ case_else? ~ END }
CASE = @{ ^"case" ~ !ident_char }
WHEN = @{ ^"when" ~ !ident_char }
THEN = @{ ^"then" ~ !ident_char }
ELSE = @{ ^"else" ~ !ident_char }
END = @{ ^"end" ~ !ident_char }
case_subject = { !WHEN ~ expression }
when_clause = { WHEN ~ expression ~ THEN ~ expression }
case_else = { ELSE ~ expression }
function_call = { identifier ~ "(" ~ DISTINCT? ~ (star_argument | expression_list)? ~ ")" }
star_argument = { "*" }
expression_list = { expression ~ ("," ~ expression)* }
list_literal = { "[" ~ expression_list? ~ "]" }
literal = { hex_integer | octal_integer | real | integer | string | TRUE | FALSE | NULL }
hex_integer = @{ "-"? ~ "0" ~ ^"x" ~ ASCII_HEX_DIGIT+ }
octal_integer = @{ "-"? ~ "0" ~ ^"o" ~ ASCII_OCT_DIGIT+ }

map_literal = { "{" ~ (map_entry ~ ("," ~ map_entry)*)? ~ "}" }
map_entry = { identifier ~ ":" ~ expression }
